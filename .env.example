# TypeSafe (Jev) — https://console.typesafe.ai
TYPESAFE_API_KEY=

# Gradium STT/TTS — https://gradium.ai
GRADIUM_API_KEY=
# GRADIUM_VOICE_ID=            # optional; plugin default voice if unset
# GRADIUM_STT_MODEL=default
# GRADIUM_TTS_MODEL=default

# LLM for (a) brief chat replies and (b) writing new AppleScript tools.
# Default: LiveKit Inference, billed to your LiveKit Cloud project (needs the LIVEKIT_* vars below).
# MACBROW_LLM_PROVIDER=livekit          # or "lmstudio" for a local model
# MACBROW_CHAT_MODEL=openai/gpt-5-mini
# MACBROW_CODEGEN_MODEL=openai/gpt-5-mini
# MACBROW_REASONING_EFFORT=low          # codegen; chat uses MACBROW_CHAT_REASONING=minimal
# MACBROW_LEARN=1                       # set 0 to disable the codegen fallback

# Local alternative via LM Studio (Developer tab -> Start Server; default port 1234):
# MACBROW_LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# MACBROW_CHAT_MODEL=qwen/qwen3.5-9b
# MACBROW_CODEGEN_MODEL=qwen/qwen3.5-9b
# MACBROW_REASONING_EFFORT=none         # Qwen 3.5 thinks by default; "none" turns it off

# Chrome: every Chrome launch uses the profile signed in as this email (see macbrow/chrome.py).
# MACBROW_CHROME_PROFILE_EMAIL=you@example.com   # unset: Chrome's last-used profile
# MACBROW_CHROME_PROFILE_DIR=Profile 1          # override by directory name instead of email
# MACBROW_CHROME_HOME=                     # URL for "open Chrome"; empty = new-tab page

# Browser tasks (jev-ultrafast in your Chrome). Requires chrome://inspect/#remote-debugging enabled.
# MACBROW_BROWSER_BUDGET_S=90

# LiveKit Cloud — `lk app env -w` writes these to .env.local for the default lk project.
# Needed for LiveKit Inference and for `agent.py dev`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
